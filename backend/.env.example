# ─── Server ─────────────────────────────────────────────────────────
YTHOOK_HOST=0.0.0.0
YTHOOK_PORT=8800

# ─── Data Storage (mounted volume) ──────────────────────────────────
YTHOOK_DATA_DIR=/data

# ─── Redirect Base URL ──────────────────────────────────────────────
# Used in digest links. Example: https://yt.example.com/r
# Set this to your public-facing backend URL
YTHOOK_REDIRECT_BASE=http://localhost:8800/r

# ─── Telegram Bot ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Google OAuth ───────────────────────────────────────────────────
# Path to google_token.json inside the container
YTHOOK_GOOGLE_CREDS=/data/google_token.json

# ─── Digest Settings ────────────────────────────────────────────────
YTHOOK_DIGEST_HOURS=3
